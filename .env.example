# 复制为 .env 后按需填写，便于复现与部署
# 项目根目录（run.py 所在目录）；子进程/脚本可据此定位路径
# PROGRAM_ROOT=

# ---------- PPIO 接口（C 模块合成节点默认 LLM）----------
# PPIO_API_KEY=
# PPIO_BASE_URL=https://api.ppio.com/openai
# PPIO_MODEL_NAME=qwen/qwen3-4b-fp8

# ---------- D 微调模型（可选）----------
# USE_FINETUNED_MODEL=0
# FINETUNED_MODEL_PATH=

# ---------- B 模块（可选）----------
# B_CHROMA_DB_DIR=
# B_PDF_DIR=
# B_MODEL_PATH=

# ---------- E API -----------
# HOST=0.0.0.0
# PORT=8000
